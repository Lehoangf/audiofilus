#!/bin/sh
# Replacement for Knulli's /usr/bin/trimui-volume-attenuate on the TrimUI Brick
# Pro, bind-mounted by the fn_switch service.
#
# The stock script sets the analog "Headphone" gain to 3 when the headphones are
# plugged and to 0 when they are unplugged. TrimUI inverted that port (see
# WirePlumber's 51-builtinspeaker.conf), so 0 is the gain that makes the internal
# speaker loud. Keep the stock gains, but change two things:
#
#   - use "amixer cset name=..." instead of "sset": the name in the driver is
#     "Headphone Volume"/"Headphone Switch", and "sset 'Headphone Volume'" fails
#     with "Unable to find simple control" (the simple element is just
#     "Headphone", and it also carries the switch);
#   - force the switch on, so a manual mute cannot survive a plug/unplug.

case "$1" in
    headphone)
        amixer -q -c 0 cset name='Headphone Volume' 3
        amixer -q -c 0 cset name='Headphone Switch' on
        ;;
    speaker)
        amixer -q -c 0 cset name='Headphone Volume' 0
        amixer -q -c 0 cset name='Headphone Switch' on
        ;;
    *)
        echo "Usage: $0 [speaker|headphone]" >&2
        exit 1
        ;;
esac

exit 0
